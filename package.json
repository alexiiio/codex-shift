{
  "name": "codex-shift",
  "version": "0.1.0",
  "description": "Cross-platform account switching for OpenAI Codex CLI.",
  "type": "module",
  "bin": {
    "codex-shift": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "keywords": ["openai", "codex", "cli", "account", "profile", "switcher"],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
